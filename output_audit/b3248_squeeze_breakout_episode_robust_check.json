  "generator": "\"\"\"S6-B3248 (2) - DOES AN EDGE SURVIVE OUTSIDE ITS LARGEST MONTH? (B3139q-r128)\n\nThe owner ruled 2026-10-27, verbatim 'Approve all recs fable mode', on the\nr124 close's recommendation for S6-B3248: '(1)(a), then (2)(b) unless an edge\nsurvives outside April 2025, and (3) add both'. (2)(b) closes the campaign\nCLOSED-NO-READ; this artifact decides whether its condition holds. In-sample\nonly - no holdout row is read.\n\nCRITERION, written before the r128 grids ran. It is NOT blind: the r116\nepisode check already reported vix_value ge 31.37 at IS sharpe 1.748 on 19\ntrades without 2025-04, so one candidate survivor was known when this was\nwritten. An edge SURVIVES outside its largest month when some non-npt row of\nthe r128 breadth search (the 14-axis grid and the B10 / B12 covered-fire\nre-sweeps) keeps, with its OWN largest month removed, an IS Sharpe - the\ngrid's S6-B3315 field is_sharpe_without_top_month, scored by the grid's row\nscorer at its floor of 10 trades - ABOVE the production base's IS Sharpe at\nthe same exit with that same month removed (same scorer, same floor, the\nsame frame the grid graded). Any survivor: (2)(b) does not apply and the read\ndecision returns to the owner. None: (2)(b), close CLOSED-NO-READ. The rule\nleans to asking rather than closing on purpose - with hundreds of rows a\nchance survivor is likely, and closing is the owner-worded act.\n\nUsage: s3248_episode_robust.py --out <json> <grid.json>...\n\"\"\"\nimport argparse\nimport json\nimport sys\nfrom pathlib import Path\n\nimport pandas as pd\n\nROOT = Path(r\"C:\\Users\\jeetm\\Github\\stock-picks-app\")\nsys.path.insert(0, str(ROOT / \"scripts\"))\nimport breadth_step1_grid as bg  # noqa: E402\nimport roster_core as rc  # noqa: E402\n\n\ndef month_of(d) -> str:\n    return str(d)[:7]\n\n\ndef evaluate(path: Path) -> dict:\n    g = json.loads(path.read_text(encoding=\"utf-8\"))\n    keys = [a[\"key\"] for a in g[\"axes\"]]\n    m, _ = bg.build_frame(g[\"strategy\"], g.get(\"depth_base\"), keys, basis=g[\"basis\"],\n                          leg=g[\"leg\"], survival=bool(g.get(\"survival\")))\n    wid = g.get(\"widen_coverage\")\n    if wid:\n        m = m[m[g[\"axis\"]].notna()].copy()\n    ins = rc.in_sample(m)\n    ins = ins.assign(_month=[month_of(d) for d in ins[\"entry_date\"]])\n    cache = {}\n\n    def prod_wo(ex, mon):\n        if (ex, mon) not in cache:\n            sub = ins[(ins[\"exit_method\"] == ex) & (ins[\"_month\"] != mon)]\n            cache[(ex, mon)] = bg._row_sharpe(sub)\n        return cache[(ex, mon)]\n    evaluated, survivors = 0, []\n    for r in g[\"rows\"]:\n        if r.get(\"npt_barred\"):\n            continue\n        ep = r.get(\"episode\") or {}\n        w = ep.get(\"is_sharpe_without_top_month\")\n        if w is None:\n            continue\n        evaluated += 1\n        p = prod_wo(r[\"exit\"], ep[\"top_month\"])\n        if p is not None and w > p:\n            survivors.append({\"axis\": r[\"axis\"], \"op\": r[\"op\"], \"level\": r[\"level\"],\n                              \"exit\": r[\"exit\"], \"is_sharpe\": r[\"is_sharpe\"],\n                              \"top_month\": ep[\"top_month\"], \"top_month_share\": ep[\"top_month_share\"],\n                              \"n_without_top_month\": ep[\"n_without_top_month\"],\n                              \"is_sharpe_without_top_month\": w,\n                              \"production_without_that_month\": round(p, 4),\n                              \"margin\": round(w - p, 4)})\n    survivors.sort(key=lambda s: -s[\"margin\"])\n    # POST-HOC DIAGNOSTIC, written AFTER the verdict above was first computed:\n    # 'beats production without that month' admitted rows that are merely\n    # less negative (production itself is negative without 2025-04 at most\n    # exits). This view keeps survivors POSITIVE without their month on at\n    # least rc.MIN_N trades (the roster's power floor), ranked by that\n    # Sharpe. It informs the owner's read decision; it never changes the verdict.\n    strong = sorted((s for s in survivors if s[\"is_sharpe_without_top_month\"] > 0\n                     and s[\"n_without_top_month\"] >= rc.MIN_N),\n                    key=lambda s: -s[\"is_sharpe_without_top_month\"])\n    pn = g.get(\"permutation_null\") or {}\n    return {\"artifact\": str(path.relative_to(ROOT)) if path.is_relative_to(ROOT) else str(path),\n            \"basis\": g[\"basis\"], \"leg\": g[\"leg\"], \"widen_coverage\": wid,\n            \"rows_non_npt\": sum(1 for r in g[\"rows\"] if not r.get(\"npt_barred\")),\n            \"rows_measurable_without_top_month\": evaluated,\n            \"survivors\": len(survivors), \"top_survivors\": survivors[:15],\n            \"post_hoc_positive_min_n\": {\"label\": \"POST-HOC DIAGNOSTIC - written after the verdict; \"\n                                                 \"never changes it\",\n                                        \"floor_n\": rc.MIN_N, \"count\": len(strong),\n                                        \"top\": strong[:10]},\n            \"null_context\": {\"observed_best_is_sharpe\": pn.get(\"observed_best_is_sharpe\"),\n                             \"null_max_p95\": pn.get(\"null_max_p95\"), \"p_value\": pn.get(\"p_value\")}}\n\n\ndef main() -> int:\n    ap = argparse.ArgumentParser()\n    ap.add_argument(\"--out\", required=True)\n    ap.add_argument(\"grids\", nargs=\"+\")\n    a = ap.parse_args()\n    parts = [evaluate(Path(p).resolve()) for p in a.grids]\n    total = sum(p[\"survivors\"] for p in parts)\n    rec = {\"ticket\": \"S6-B3248 (2)\", \"criterion\": __doc__.split(\"CRITERION, written before the r128 grids ran.\", 1)[1].split(\"Usage:\", 1)[0].strip(),\n           \"owner_ruling_verbatim\": \"Approve all recs fable mode\",\n           \"ruled_recommendation\": \"(1)(a), then (2)(b) unless an edge survives outside April 2025, and (3) add both\",\n           \"artifacts\": parts, \"survivors_total\": total,\n           \"verdict\": (\"AN EDGE SURVIVES OUTSIDE ITS LARGEST MONTH - (2)(b) does not apply; the read \"\n                       \"decision returns to the owner\" if total else\n                       \"NO EDGE SURVIVES OUTSIDE ITS LARGEST MONTH - (2)(b) applies: close CLOSED-NO-READ\"),\n           \"generator\": Path(__file__).read_text(encoding=\"utf-8\")}\n    Path(a.out).write_text(json.dumps(rec, indent=2), encoding=\"utf-8\")\n    print(rec[\"verdict\"], \"| survivors\", total)\n    for p in parts:\n        print(f\"  {Path(p['artifact']).name}: {p['survivors']} of {p['rows_measurable_without_top_month']} \"\n              f\"measurable rows (of {p['rows_non_npt']} non-npt)\")\n        ph = p[\"post_hoc_positive_min_n\"]\n        print(f\"     post-hoc: {ph['count']} survivors positive without their month on >= {ph['floor_n']} trades\")\n        for s in ph[\"top\"][:6]:\n            print(f\"     {s['axis']} {s['op']} {s['level']} @{s['exit']}: IS {s['is_sharpe']}; without \"\n                  f\"{s['top_month']} (share {s['top_month_share']}) {s['is_sharpe_without_top_month']} on \"\n                  f\"{s['n_without_top_month']} vs production {s['production_without_that_month']}\")\n    return 0\n\n\nif __name__ == \"__main__\":\n    raise SystemExit(main())\n"
}