#!/bin/sh
# Pass 53 Day-9 v8h+1 owner-mandated pre-commit hook.
# Blocks commits that violate the most-violated CHECKLIST rules:
# C1 unicode in runtime code, C2 em-dash, C3 canonical-source, C4 git-commit-capture
#
# Install once via: scripts/install_git_hooks.bat (Windows) or scripts/install_git_hooks.sh
#
# Bypass (emergency only, owner-aware): git commit --no-verify

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT" || exit 1

python scripts/preflight.py --staged
EXIT=$?

if [ $EXIT -ne 0 ]; then
    echo ""
    echo "==================================================================="
    echo "COMMIT BLOCKED by preflight - fix violations above and try again."
    echo "==================================================================="
    exit 1
fi

# INV-045 propagation Pass 53 Day-9 v8h+1 2026-05-08:
# Block commits when reference-doc numerical claims drift from source-of-truth
# tables. Run sync_doc_counts.py --check; if drift detected, exit non-zero with
# remediation hint.
python scripts/sync_doc_counts.py --check
SYNC_EXIT=$?

if [ $SYNC_EXIT -ne 0 ]; then
    echo ""
    echo "==================================================================="
    echo "COMMIT BLOCKED by doc count drift detector."
    echo "Fix: python scripts/sync_doc_counts.py --update"
    echo "Then stage the updated docs and re-commit."
    echo "==================================================================="
    exit 1
fi

exit 0
